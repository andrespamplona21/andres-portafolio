# Resend API key — opcional. Sin esto, el form solo loguea en consola (modo dev).
# Crea una cuenta gratis en https://resend.com y copia tu API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# A dónde llegan los mensajes del formulario de contacto
CONTACT_TO=andrespamplonao@gmail.com

# Remitente. Por defecto usa onboarding@resend.dev (no requiere dominio, pero
# solo entrega a tu propio correo). Cuando verifiques tu dominio en Resend,
# cámbialo a algo como "Portafolio <hola@tudominio.com>".
CONTACT_FROM=Portafolio <onboarding@resend.dev>
